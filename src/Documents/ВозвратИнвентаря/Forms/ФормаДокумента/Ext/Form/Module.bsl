&НаКлиенте
Процедура ЗаполнитьПоОстаткам(Команда)

    Если НЕ ЗначениеЗаполнено(Объект.Сотрудник) Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Сначала выберите сотрудника";
        Сообщение.Поле  = "Объект.Сотрудник";
        Сообщение.Сообщить();
        Возврат;
    КонецЕсли;

    ЗаполнитьПоОстаткамНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОстаткамНаСервере()

    ТаблицаОстатков = ОстаткиСотрудника(Объект.Сотрудник, Объект.Дата);

    Объект.Позиции.Очистить();
    Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
        НоваяСтрока = Объект.Позиции.Добавить();
        НоваяСтрока.Инвентарь  = СтрокаОстатка.Инвентарь;
        НоваяСтрока.Количество = СтрокаОстатка.Остаток;
        НоваяСтрока.Состояние  = Перечисления.СостоянияИнвентаря.Исправен;
    КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОстаткиСотрудника(Сотрудник, ДатаОстатков)

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    Остатки.Инвентарь         КАК Инвентарь,
        |    Остатки.КоличествоОстаток КАК Остаток
        |ИЗ
        |    РегистрНакопления.ИнвентарьУСотрудников.Остатки(
        |        &ДатаОстатков,
        |        Сотрудник = &Сотрудник) КАК Остатки
        |ГДЕ
        |    Остатки.КоличествоОстаток > 0
        |УПОРЯДОЧИТЬ ПО
        |    Остатки.Инвентарь";

    Запрос.УстановитьПараметр("Сотрудник",    Сотрудник);
    Запрос.УстановитьПараметр("ДатаОстатков", ?(ЗначениеЗаполнено(ДатаОстатков),
                                                    ДатаОстатков, ТекущаяДатаСеанса()));

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции