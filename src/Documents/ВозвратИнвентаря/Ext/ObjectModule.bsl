Процедура ОбработкаПроведения(Отказ, Режим)

    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрНакопления.ИнвентарьУСотрудников");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.ИсточникДанных = Позиции;
    Элемент.ИспользоватьИзИсточникаДанных("Инвентарь", "Инвентарь");
    Элемент.УстановитьЗначение("Сотрудник", Сотрудник);
    Блокировка.Заблокировать();

    Движения.ИнвентарьУСотрудников.Записывать = Истина;

    Для Каждого СтрокаПозиции Из Позиции Цикл
        Движение = Движения.ИнвентарьУСотрудников.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период      = Дата;
        Движение.Сотрудник   = Сотрудник;
        Движение.Инвентарь   = СтрокаПозиции.Инвентарь;
        Движение.Количество  = СтрокаПозиции.Количество;
    КонецЦикла;

    Движения.ИнвентарьУСотрудников.Записать();

    ПроверитьОстатки(Отказ);

КонецПроцедуры

Процедура ПроверитьОстатки(Отказ)

    СписокИнвентаря = Позиции.ВыгрузитьКолонку("Инвентарь");

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    Остатки.Инвентарь          КАК Инвентарь,
        |    Остатки.КоличествоОстаток  КАК Остаток
        |ИЗ
        |    РегистрНакопления.ИнвентарьУСотрудников.Остатки(
        |        &МоментВремени,
        |        Сотрудник = &Сотрудник
        |            И Инвентарь В (&СписокИнвентаря)) КАК Остатки
        |ГДЕ
        |    Остатки.КоличествоОстаток < 0";

    Запрос.УстановитьПараметр("МоментВремени",
        Новый Граница(МоментВремени(), ВидГраницы.Включая));
    Запрос.УстановитьПараметр("Сотрудник",       Сотрудник);
    Запрос.УстановитьПараметр("СписокИнвентаря", СписокИнвентаря);

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = СтрШаблон(
            "У сотрудника ""%1"" не числится ""%2"" в таком количестве. Не хватает: %3",
            Сотрудник, Выборка.Инвентарь, -Выборка.Остаток);
        Сообщение.Сообщить();
        Отказ = Истина;
    КонецЦикла;

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

    Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВыдачаИнвентаря") Тогда

        Сотрудник         = ДанныеЗаполнения.Сотрудник;
        ДокументОснование = ДанныеЗаполнения;

        Позиции.Очистить();
        Для Каждого СтрокаОснования Из ДанныеЗаполнения.Позиции Цикл
            НоваяСтрока = Позиции.Добавить();
            ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОснования);
            НоваяСтрока.Состояние = Перечисления.СостоянияИнвентаря.Исправен;
        КонецЦикла;

    КонецЕсли;

КонецПроцедуры